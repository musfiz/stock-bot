# কপি করে .env বানান: copy .env.example .env
# শুধু SELECT অধিকারসহ MySQL user বানান:
# CREATE USER 'inventory_reader'@'localhost' IDENTIFIED BY 'change-me';
# GRANT SELECT ON grocery.* TO 'inventory_reader'@'localhost';
DB_HOST=localhost
DB_USER=inventory_reader
DB_PASSWORD=change-me
DB_NAME=grocery
QDRANT_URL=http://localhost:6333
EMBED_MODEL=bge-m3
CHAT_MODEL=qwen2.5:3b
COLLECTION=products
EMBED_DIM=1024
OLLAMA_KEEP_ALIVE=30m
# Ollama সার্ভারে সেট করুন: OLLAMA_MAX_LOADED_MODELS=2
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,https://your-shop.com
ADMIN_TOKEN=
